{
  "manifest_version": 3,
  "name": "يمينك Arabic RTL Fix",
  "short_name": "يمينك",
  "version": "1.0.0",

  "description": "إصلاح ذكي لاتجاه النص العربي وعرض الأرقام والقوائم في موضعها الصحيح | Smart Arabic RTL fix: numbers, bullets and lists on the right side",
  "author": "7SM",

  "browser_specific_settings": {
    "gecko": {
      "id": "aaaszzxx909@gmail.com",
      "strict_min_version": "109.0"
    }
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "icons/icon-16.svg",
      "32":  "icons/icon-32.svg",
      "48":  "icons/icon-48.svg",
      "128": "icons/icon-128.svg"
    },
    "default_title": "يمينك لإصلاح اتجاه النص العربي"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "*://chat.deepseek.com/*",
        "*://*.notion.so/*",
        "*://*.perplexity.ai/*",
        "*://copilot.microsoft.com/*",
        "*://*.grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "toggle-rtl": {
      "suggested_key": { "default": "Alt+G" },
      "description": "تفعيل / إلغاء إصلاح RTL"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+O" }
    }
  },

  "permissions": [
    "storage",
    "tabs"
  ],

  "icons": {
    "16":  "icons/icon-16.svg",
    "32":  "icons/icon-32.svg",
    "48":  "icons/icon-48.svg",
    "128": "icons/icon-128.svg"
  }
}
